{
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "buffer": "^6.0.3",
    "firebase": "^12.14.0",
    "firebase-tools": "15.29.0",
    "jest": "^30.4.2",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "sass": "^1.101.0",
    "tailwindcss": "^4.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "firebase emulators:exec --only=auth,firestore parcel",
    "build": "parcel build",
    "rules:compose": "node scripts/compose-firestore-rules.js --production firestore.rules --out firestore.composed.rules",
    "prestart": "npm run rules:compose",
    "pretest": "npm run rules:compose",
    "deploy:rules": "npm run rules:compose && firebase --project records-classificater deploy --only firestore:rules",
